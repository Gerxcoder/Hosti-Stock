# MySQL
MYSQL_ROOT_PASSWORD=<cambia-esto>
MYSQL_DATABASE=hostistock
MYSQL_USER=hostistock
MYSQL_PASSWORD=<cambia-esto>

# Backend Spring Boot
SPRING_PROFILES_ACTIVE=docker
SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/hostistock?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=hostistock
SPRING_DATASOURCE_PASSWORD=<cambia-esto>

# JWT
# Genera un secreto seguro: openssl rand -base64 32
APP_JWT_SECRETO=<genera-un-secreto-de-minimo-32-caracteres>
APP_JWT_EXPIRACION_MS=86400000

# IA
APP_IA_URL=http://ia:8000